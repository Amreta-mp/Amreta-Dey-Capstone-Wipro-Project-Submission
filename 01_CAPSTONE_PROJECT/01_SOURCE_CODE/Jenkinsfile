pipeline {
    agent any

    stages {
        stage('Setup') {
            steps {
                bat 'python -m venv venv'
                bat 'venv\\Scripts\\pip install -r requirements.txt'
            }
        }
        stage('Smoke Tests') {
            steps {
                bat 'venv\\Scripts\\robot --variable BROWSER:headlesschrome --outputdir reports tests\\smoke'
            }
        }
        stage('Regression Tests') {
            steps {
                bat 'venv\\Scripts\\robot --variable BROWSER:headlesschrome --outputdir reports tests\\regression'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
    }
}